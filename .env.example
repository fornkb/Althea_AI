# Copy to .env; it is ignored by Git. Never commit actual credentials.
# Primary route: Gemini Developer API. No Vertex project or ADC required.
ALTHEA_PROVIDER=gemini
GEMINI_API_KEY=
ALTHEA_GEMINI_AUDIO_MODEL=gemini-3.5-flash-lite
ALTHEA_TEXT_MODEL=gemini-3.5-flash-lite
ALTHEA_GROUNDING_MODEL=gemini-3.5-flash-lite
ALTHEA_DATA_DIR=data
# Audio/text free-tier eligibility and quotas depend on your key's project.
# Google Search grounding for this model requires the paid tier.

# Optional Vertex route: set ALTHEA_PROVIDER=vertex and configure ADC.
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global
# ALTHEA_TRANSCRIBE_MODEL=gemini-3.5-transcribe
