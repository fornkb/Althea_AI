# Application loads .env. Keep actual credentials outside this repository.
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
ALTHEA_TRANSCRIBE_MODEL=gemini-3.5-transcribe
ALTHEA_TEXT_MODEL=gemini-2.5-flash
ALTHEA_GROUNDING_MODEL=gemini-2.5-flash
ALTHEA_DATA_DIR=data
# Alternative Gemini Developer API key route (free-tier eligibility/quotas apply).
# ALTHEA_PROVIDER=gemini
# GEMINI_API_KEY=your-key-here
# ALTHEA_GEMINI_AUDIO_MODEL=gemini-2.5-flash
