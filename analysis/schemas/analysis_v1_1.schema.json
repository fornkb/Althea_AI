{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "speaker_id": {
          "minLength": 1,
          "title": "Speaker Id",
          "type": "string"
        },
        "proposition": {
          "minLength": 1,
          "title": "Proposition",
          "type": "string"
        },
        "subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Subject"
        },
        "metric": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Metric"
        },
        "period": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Period"
        },
        "geography": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Geography"
        },
        "population": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Population"
        },
        "measurement_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Measurement Basis"
        },
        "qualifiers": {
          "items": {
            "type": "string"
          },
          "title": "Qualifiers",
          "type": "array"
        },
        "checkability": {
          "enum": [
            "checkable",
            "needs_context"
          ],
          "title": "Checkability",
          "type": "string"
        },
        "missing_context": {
          "items": {
            "type": "string"
          },
          "title": "Missing Context",
          "type": "array"
        },
        "source_spans": {
          "items": {
            "$ref": "#/$defs/SourceSpan"
          },
          "title": "Source Spans",
          "type": "array"
        },
        "quantity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "claim_id",
        "speaker_id",
        "proposition",
        "subject",
        "metric",
        "period",
        "geography",
        "population",
        "measurement_basis",
        "qualifiers",
        "checkability",
        "missing_context",
        "source_spans",
        "quantity"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "stage": {
          "enum": [
            "input",
            "transcription",
            "analysis",
            "verification",
            "storage",
            "integration"
          ],
          "title": "Stage",
          "type": "string"
        },
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "related_ids": {
          "items": {
            "type": "string"
          },
          "title": "Related Ids",
          "type": "array"
        }
      },
      "required": [
        "stage",
        "code",
        "message",
        "retryable",
        "related_ids"
      ],
      "title": "Issue",
      "type": "object"
    },
    "PairAssessment": {
      "additionalProperties": false,
      "properties": {
        "pair_id": {
          "minLength": 1,
          "title": "Pair Id",
          "type": "string"
        },
        "claim_a_id": {
          "minLength": 1,
          "title": "Claim A Id",
          "type": "string"
        },
        "claim_b_id": {
          "minLength": 1,
          "title": "Claim B Id",
          "type": "string"
        },
        "relation": {
          "enum": [
            "direct_conflict",
            "numeric_discrepancy",
            "compatible",
            "different_scope",
            "insufficient_context"
          ],
          "title": "Relation",
          "type": "string"
        },
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "numeric_difference": {
          "anyOf": [
            {
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Numeric Difference"
        },
        "numeric_difference_unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Numeric Difference Unit"
        },
        "priority": {
          "enum": [
            1,
            2,
            3
          ],
          "title": "Priority",
          "type": "integer"
        },
        "method": {
          "enum": [
            "deterministic",
            "llm",
            "hybrid",
            "fixture"
          ],
          "title": "Method",
          "type": "string"
        }
      },
      "required": [
        "pair_id",
        "claim_a_id",
        "claim_b_id",
        "relation",
        "explanation",
        "numeric_difference",
        "numeric_difference_unit",
        "priority",
        "method"
      ],
      "title": "PairAssessment",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "properties": {
        "raw_text": {
          "minLength": 1,
          "title": "Raw Text",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "lower": {
          "anyOf": [
            {
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lower"
        },
        "upper": {
          "anyOf": [
            {
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Upper"
        },
        "operator": {
          "enum": [
            "eq",
            "approx",
            "gt",
            "ge",
            "lt",
            "le",
            "range"
          ],
          "title": "Operator",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Currency"
        },
        "basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Basis"
        }
      },
      "required": [
        "raw_text",
        "value",
        "lower",
        "upper",
        "operator",
        "unit",
        "currency",
        "basis"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "properties": {
        "segment_id": {
          "minLength": 1,
          "title": "Segment Id",
          "type": "string"
        },
        "start_char": {
          "minimum": 0,
          "title": "Start Char",
          "type": "integer"
        },
        "end_char": {
          "exclusiveMinimum": 0,
          "title": "End Char",
          "type": "integer"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "segment_id",
        "start_char",
        "end_char",
        "quote"
      ],
      "title": "SourceSpan",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "stage": {
          "enum": [
            "transcription",
            "extraction",
            "comparison",
            "retrieval",
            "adjudication"
          ],
          "title": "Stage",
          "type": "string"
        },
        "provider": {
          "enum": [
            "vertex",
            "gemini",
            "fixture"
          ],
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "request_count": {
          "minimum": 0,
          "title": "Request Count",
          "type": "integer"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Output Tokens"
        }
      },
      "required": [
        "stage",
        "provider",
        "model",
        "request_count",
        "input_tokens",
        "output_tokens"
      ],
      "title": "Usage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "analysis_id": {
      "minLength": 1,
      "title": "Analysis Id",
      "type": "string"
    },
    "transcript_id": {
      "minLength": 1,
      "title": "Transcript Id",
      "type": "string"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    },
    "pairs": {
      "items": {
        "$ref": "#/$defs/PairAssessment"
      },
      "title": "Pairs",
      "type": "array"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/Issue"
      },
      "title": "Issues",
      "type": "array"
    },
    "usage": {
      "items": {
        "$ref": "#/$defs/Usage"
      },
      "title": "Usage",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "analysis_id",
    "transcript_id",
    "claims",
    "pairs",
    "issues",
    "usage"
  ],
  "title": "Analysis",
  "type": "object"
}
