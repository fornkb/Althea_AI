{
  "$defs": {
    "Analysis": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "analysis_id": {
          "minLength": 1,
          "title": "Analysis Id",
          "type": "string"
        },
        "transcript_id": {
          "minLength": 1,
          "title": "Transcript Id",
          "type": "string"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Claims",
          "type": "array"
        },
        "pairs": {
          "items": {
            "$ref": "#/$defs/PairAssessment"
          },
          "title": "Pairs",
          "type": "array"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "title": "Issues",
          "type": "array"
        },
        "usage": {
          "items": {
            "$ref": "#/$defs/Usage"
          },
          "title": "Usage",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "analysis_id",
        "transcript_id",
        "claims",
        "pairs",
        "issues",
        "usage"
      ],
      "title": "Analysis",
      "type": "object"
    },
    "Claim": {
