          "title": "Qualifiers",
          "type": "array"
        },
        "checkability": {
          "enum": [
            "checkable",
            "needs_context"
          ],
          "title": "Checkability",
          "type": "string"
        },
        "missing_context": {
          "items": {
            "type": "string"
          },
          "title": "Missing Context",
          "type": "array"
