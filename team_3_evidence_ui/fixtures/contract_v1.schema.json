        },
        "quantity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "claim_id",
        "speaker_id",
        "proposition",
        "subject",
        "metric",
        "period",
        "geography",
        "population",
        "measurement_basis",
        "qualifiers",
        "checkability",
        "missing_context",
        "source_spans",
        "quantity"
